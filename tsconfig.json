{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tsdown.config.ts", "vitest.config.ts"]
}
